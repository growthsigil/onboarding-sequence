# ─────────────────────────────────────────────────────────────────────────────
# Onboarding Sequence - environment variables
# Copy to `.env.local` for local dev, and set the same keys in Vercel
# (Settings → Environment Variables) for production. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cron (required) ──
# Gates the daily follow-up tick and the manual /api/payment/received endpoint.
# Vercel Cron sends it automatically.
CRON_SECRET=invent-a-long-random-string

# ── Email delivery ──
# Pick ONE provider per business via clients.email_provider ('resend' default,
# or 'ghl'). Set the keys for whichever you use.
#
# Resend (recommended - simplest to set up). https://resend.com → API Keys.
RESEND_API_KEY=
# GoHighLevel - only needed if a client uses email_provider = 'ghl', or as the
# source of the "payment received" signal. The per-location token lives on the
# client row (clients.ghl_api_key); this secret verifies the GHL webhook.
GHL_WEBHOOK_SECRET=invent-a-long-random-string

# ── Stripe (optional - a payment source) ──
# Set this if you trigger onboarding from Stripe. The webhook signing secret
# from Stripe → Developers → Webhooks (starts with `whsec_`).
STRIPE_WEBHOOK_SECRET=

# ── Public app URL (required for unsubscribe links) ──
# Your deployed URL, e.g. https://onboarding.yourdomain.com - used to build the
# one-click unsubscribe link in every email footer.
APP_URL=https://YOUR-APP.vercel.app

# ── Claude / Anthropic (optional) ──
# When set, each email can be written in the client's voice. When unset, the
# built-in placeholder templates are used verbatim (still fully functional).
ANTHROPIC_API_KEY=
# Model that writes the emails. Override to any current model id.
ONBOARDING_MODEL=claude-sonnet-4-6

# ── Telegram (optional) ──
# When set, the owner gets a ping when a new customer enters onboarding.
# Bot via @BotFather; chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
